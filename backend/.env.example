# Local dev only (Cloud Functions emulator / `npm run shell`).
# In production these are set via Cloud Functions params / Secret Manager —
# never commit real values.

# Local Postgres, bypasses the Cloud SQL connector entirely:
DATABASE_URL=postgres://postgres:postgres@localhost:5432/padelhub

# Used instead of DATABASE_URL when connecting through Cloud SQL:
# INSTANCE_CONNECTION_NAME=padelhub-prod:southamerica-east1:padelhub-sql
# DB_USER=padelhub_api
# DB_PASSWORD=
# DB_NAME=padelhub
